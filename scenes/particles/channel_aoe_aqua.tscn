[gd_scene format=3 uid="uid://b5ocg2qv1i3u3"][ext_resource type="Shader" path="res://shaders/y2k_forcefield.gdshader" id="1_y2ks"]

[sub_resource type="GDScript" id="GDScript_aqua"]
script/source = "extends Node3D

func _ready() -> void:
    var tween = create_tween()
    tween.tween_property(self, \"scale\", Vector3(3.0, 3.0, 3.0), 0.4).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
    var mat = $MeshInstance3D.get_active_material(0)
    tween.parallel().tween_property(mat, \"shader_parameter/color:a\", 0.0, 0.4)
    tween.tween_callback(queue_free)
