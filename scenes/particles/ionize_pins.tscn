[gd_scene format=3 uid="uid://34h2igb6s66n"]

[sub_resource type="GDScript" id="GDScript_ionize"]
script/source = "extends Node3D
func _ready():
    var tween = create_tween()
    tween.set_parallel(true)
    for child in get_children():
        if child is MeshInstance3D:
            var start_pos = child.position
            child.position = start_pos * 2.0
            child.scale = Vector3.ZERO
            tween.tween_property(child, \"position\", Vector3.ZERO, 0.3).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_BACK)
            tween.tween_property(child, \"scale\", Vector3.ONE, 0.15)
            tween.tween_property(child, \"scale\", Vector3.ZERO, 0.1).set_delay(0.2)
    tween.chain().tween_callback(queue_free)"

