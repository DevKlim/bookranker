[gd_scene format=3 uid="uid://clghtglw"][sub_resource type="GDScript" id="GDScript_lglow"]
script/source = "extends Node3D
func _ready():
    var tween = create_tween()
    var mat = $MeshInstance3D.get_active_material(0)
    tween.tween_property(self, \"scale\", Vector3(1.5, 1.5, 1.5), 0.5).set_ease(Tween.EASE_OUT)
    tween.parallel().tween_property(mat, \"albedo_color:a\", 0.0, 0.5)
    tween.parallel().tween_property($OmniLight3D, \"light_energy\", 0.0, 0.5)
    tween.tween_callback(queue_free)
